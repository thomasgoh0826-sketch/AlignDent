{
  "name": "aligndent",
  "version": "0.1.3",
  "private": true,
  "description": "Free, source-available and privacy-first dental portrait standardization for Windows",
  "author": "Zyls",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/thomasgoh0826-sketch/AlignDent",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasgoh0826-sketch/AlignDent.git"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "playwright test tests/e2e",
    "package:win": "electron-builder --config electron-builder.yml --win nsis --x64",
    "icon": "node scripts/generate-app-icon.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.0"
  }
}
